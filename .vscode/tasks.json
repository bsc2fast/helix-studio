{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Helix Studio",
      "type": "shell",
      "command": "python3 server.py",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "helix-studio",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*helix-studio on.*",
          "endsPattern": ".*helix-studio on.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
